;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Moteur3D-Projet-Template"
run/main_scene="uid://dmjbg6r7aoiuu"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://Scripts/Manager/GameManager.gd"
UiManager="*res://Scripts/Manager/UiManager.gd"
GameDifficulty="*res://Scripts/Manager/GameDifficulty.gd"
PlayerStatManager="*res://Scripts/Manager/PlayerStatManager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/virtual_joystick/plugin.cfg")

[gui]

theme/custom="uid://kaxyagbwhk80"
theme/custom_font="uid://dm3k0wkpbkpcu"

